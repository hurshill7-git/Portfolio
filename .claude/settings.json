{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/check-em-dash.sh",
            "if": "Bash(git push*)",
            "timeout": 120,
            "statusMessage": "Checking rendered pages for em-dashes before push..."
          }
        ]
      }
    ]
  }
}
